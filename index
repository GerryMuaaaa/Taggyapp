<style>
/* Sin dependencias externas: usa fuentes del sistema, funciona offline y en cualquier hosting */
:root{--cream:#FFF8ED;--orange:#EF8A27;--deep:#B85C14;--yellow:#F7C957;--sage:#86A79B;--blue:#9BC3CE;--coral:#D9826B;--black:#202020}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;color:var(--black);background:#f1e4cf;min-height:100vh}
.app{max-width:430px;margin:auto;min-height:100vh;background:var(--cream);box-shadow:0 0 50px rgba(0,0,0,.15);padding-bottom:30px}
h1,h3,.sos{font-family:"Baloo 2",system-ui,-apple-system,"Segoe UI",Arial,sans-serif}
.sos{background:var(--coral);color:#fff;text-align:center;padding:14px;font-weight:800;font-size:1.25rem;letter-spacing:.03em}
.top{display:flex;justify-content:space-between;align-items:center;padding:14px 20px}
.logo{font-weight:900;font-size:1.5rem;color:var(--orange);letter-spacing:.02em}
.tag{display:inline-block;background:var(--yellow);padding:6px 12px;border-radius:30px;font-size:.7rem;font-weight:800}
.wrap{padding:6px 18px}
.card{background:#fff;border-radius:28px;padding:18px;margin-bottom:14px;box-shadow:0 10px 26px rgba(0,0,0,.07)}
.hero{text-align:center}
.pic{position:relative;border-radius:30px;overflow:hidden;aspect-ratio:1;background:linear-gradient(140deg,var(--blue),var(--sage));display:flex;align-items:center;justify-content:center;border:4px solid var(--coral)}
.pic img{width:100%;height:100%;object-fit:cover;object-position:center 92%;display:block}
.pic .em{font-size:7rem}
.chip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#fff;padding:8px 16px;border-radius:30px;font-weight:800;font-size:.72rem;white-space:nowrap;box-shadow:0 8px 20px rgba(0,0,0,.2)}
.chip i{color:var(--coral);font-style:normal}
h1{font-size:3rem;line-height:1;margin-top:14px}
.rae{display:inline-block;text-align:left;margin:10px 0 12px;font-size:1rem;line-height:1.6}
.rae span{opacity:.6;font-weight:700}
.chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.chips span{padding:7px 12px;border-radius:20px;font-size:.75rem;font-weight:800;background:var(--blue)}
.chips span.o{background:#FCE8CC}
.msg{background:#FCE8CC;border-radius:22px;padding:16px;margin-top:14px;text-align:left;font-size:.92rem;line-height:1.5}
.btn{display:block;width:100%;text-align:center;padding:17px;border-radius:30px;border:1.5px solid var(--black);font-weight:800;font-size:1.05rem;font-family:inherit;cursor:pointer;margin-top:10px;text-decoration:none;color:var(--black);background:#fff}
.btn:active{transform:scale(.97)}
.btn.call{background:var(--deep);border-color:var(--deep);color:#fff;font-size:1.2rem}
.btn.wa{background:#2f6b4f;border-color:#2f6b4f;color:#fff}
.btn.loc{background:var(--yellow);border-color:var(--yellow)}
.btn.or{background:var(--orange);border-color:var(--orange)}
h3{font-size:1.35rem;margin-bottom:12px}
.lab{font-size:.68rem;font-weight:800;letter-spacing:.06em;opacity:.55}
.box{background:var(--cream);border-radius:16px;padding:12px 14px;margin-bottom:8px;line-height:1.45}
.rw{background:var(--yellow)}.rw strong{font-size:1.2rem}
.ph{display:flex;align-items:center;justify-content:space-between;gap:10px}
.ph a{width:44px;height:44px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.1rem;flex:none}
.lnk{font-weight:800;font-size:.85rem;color:var(--deep);text-decoration:none}
.pill{display:inline-block;padding:8px 12px;border-radius:20px;font-size:.78rem;font-weight:800;margin-bottom:4px}
.pill.al{background:#FBE3DD;color:#9b3a24}.pill.di{background:#FCE8CC;color:#8a5a14}.pill.mc{background:#DCEBF0;color:#2d6577}
.an{font-size:.84rem;line-height:1.4;margin:0 0 12px 6px;opacity:.85}
.tips{list-style:none;counter-reset:t}
.tips li{counter-increment:t;display:flex;gap:12px;align-items:flex-start;margin-bottom:12px;font-size:.9rem;line-height:1.45}
.tips li::before{content:counter(t);flex:none;width:28px;height:28px;border-radius:50%;background:var(--orange);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center}
form input,form textarea{width:100%;padding:13px 14px;border-radius:15px;border:1.5px solid rgba(32,32,32,.15);background:var(--cream);font:inherit;margin-bottom:8px}
form textarea{min-height:76px;resize:vertical}
.s{font-size:.85rem;opacity:.75;margin-bottom:12px;line-height:1.4}
.foot{text-align:center;font-size:.78rem;opacity:.6;padding:6px 20px}
.toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);background:var(--black);color:#fff;padding:14px 22px;border-radius:30px;font-weight:700;display:none;z-index:99}
</style>
</head>
