<script>
/* Solo para los botones interactivos. Si el JS fallara, todo lo demás se ve igual. */
var TEL="529991234567", NOMBRE="Catalino", ID="#TG-9204";
function toast(m){var t=document.getElementById("toast");t.textContent=m;t.style.display="block";setTimeout(function(){t.style.display="none"},3000)}
function wa(texto){location.href="https://wa.me/"+TEL+"?text="+encodeURIComponent(texto)}

document.getElementById("btnLoc").addEventListener("click",function(){
  var base="Hola, encontré a "+NOMBRE+" 🐾 (collar TAGGY "+ID+").";
  toast("Obteniendo tu ubicación…");
  if(!navigator.geolocation){wa(base);return}
  navigator.geolocation.getCurrentPosition(
    function(p){wa(base+" Estoy aquí: https://maps.google.com/?q="+p.coords.latitude+","+p.coords.longitude)},
    function(){wa(base)},
    {timeout:8000}
  );
});

document.getElementById("avForm").addEventListener("submit",function(e){
  e.preventDefault();
  var z=document.getElementById("avZ").value.trim(), c=document.getElementById("avC").value.trim();
  wa("Hola, vi a "+NOMBRE+" 🐾 en: "+z+"."+(c?" "+c:""));
});
</script>
